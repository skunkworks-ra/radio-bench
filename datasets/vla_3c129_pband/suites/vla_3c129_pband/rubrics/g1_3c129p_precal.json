{
  "schema_version": "0.2",
  "task_id": "g1_3c129p_precal",
  "stages": [
    "precal"
  ],
  "pass_reward_min": 0.85,
  "expect_halt": false,
  "required_reported_metrics": [],
  "hard_gates": [
    {
      "id": "unlocked_tables",
      "observable": "proc.table_locked",
      "primitive": "bool_pass",
      "params": {
        "expected": false
      },
      "zero_reward_on_fail": true,
      "zero_subscores_on_fail": true,
      "failure_tag": "lock_or_timeout"
    },
    {
      "id": "raw_data_unmodified",
      "observable": "proc.raw_data_unmodified",
      "primitive": "bool_pass",
      "params": {
        "expected": true
      },
      "zero_reward_on_fail": true,
      "optional_when_truth_missing": true,
      "failure_tag": "raw_data_or_calflag_mutation"
    }
  ],
  "core_subscore_floors": {},
  "subscores": [
    {
      "id": "calibrators_ms_score",
      "weight": 0.2,
      "failure_tag": "script_or_casa_crash",
      "label": "Calibrators MS & Scan Intents",
      "expr": {
        "combine": "multiplicative_cap",
        "children": [
          {
            "combine": "weighted_sum",
            "weights": [
              0.5,
              0.5
            ],
            "children": [
              {
                "observable": "precal.calibrators_ms_struct_ok",
                "primitive": "bool_pass",
                "label": "Calibrators MS Valid",
                "params": {
                  "expected": true
                }
              },
              {
                "combine": "weighted_sum",
                "weights": [
                  0.5,
                  0.5
                ],
                "children": [
                  {
                    "observable": "precal.calibrator_intents_ok",
                    "primitive": "bool_pass",
                    "label": "Calibrator Scan Intents",
                    "params": {
                      "expected": true
                    }
                  },
                  {
                    "observable": "precal.target_intents_ok",
                    "primitive": "bool_pass",
                    "label": "Target Scan Intents",
                    "params": {
                      "expected": true
                    }
                  }
                ]
              }
            ]
          },
          {
            "observable": "precal.calibrators_ms_struct_ok",
            "primitive": "bool_pass",
            "params": {
              "expected": true
            }
          }
        ]
      }
    },
    {
      "id": "model_data_score",
      "weight": 0.25,
      "failure_tag": "flux_model_or_fluxscale_error",
      "label": "Flux Calibrator MODEL_DATA Amplitude",
      "expr": {
        "observable": "precal.flux_cal_model_amp_jy",
        "primitive": "rel_err_ramp",
        "label": "Flux Cal MODEL_DATA Mean Amp (Jy)",
        "unit": "Jy",
        "params": {
          "truth_key": [
            "flux_cal_model_parallel_mean_jy"
          ],
          "pass_rel_tol_key": [
            "tolerances.model_amp_rel_tol"
          ],
          "zero_at_rel_err": 0.05
        }
      }
    },
    {
      "id": "model_spec_nrmse_score",
      "weight": 0.0,
      "failure_tag": "flux_model_or_fluxscale_error",
      "label": "Flux Calibrator Spectral Shape NRMSE",
      "expr": {
        "observable": "precal.flux_cal_model_spec_nrmse",
        "primitive": "upper_ramp",
        "label": "Flux Cal Spectral NRMSE",
        "params": {
          "spectrum_truth_key": [
            "flux_cal_model_parallel_per_chan_jy"
          ],
          "pass_max": 0.01,
          "zero_at": 0.05
        }
      }
    },
    {
      "id": "flag_recall_score",
      "weight": 0.3,
      "failure_tag": "flagging_recall_or_overflag",
      "label": "Online / Quack / RFI Flag Recall",
      "expr": {
        "combine": "multiplicative_cap",
        "children": [
          {
            "combine": "weighted_sum",
            "weights": [
              0.75,
              0.25
            ],
            "children": [
              {
                "observable": "precal.calibrator_must_flag_recall",
                "primitive": "lower_ramp",
                "label": "Calibrator Must-Flag Recall",
                "params": {
                  "pass_min_key": [
                    "tolerances.flag_recall_min"
                  ],
                  "zero_at": 0.5
                }
              },
              {
                "observable": "precal.target_must_flag_recall",
                "primitive": "lower_ramp",
                "label": "Target Deterministic Preflag Recall",
                "params": {
                  "pass_min": 0.4,
                  "zero_at": 0.05
                }
              }
            ]
          },
          {
            "combine": "min_of",
            "children": [
              {
                "observable": "precal.clean_false_positive_rate",
                "primitive": "threshold_gate",
                "label": "Overall Blanket-Flag Guard",
                "params": {
                  "op": "<",
                  "limit": 0.5
                }
              },
              {
                "observable": "precal.calibrator_clean_false_positive_rate",
                "primitive": "threshold_gate",
                "label": "Calibrator Blanket-Flag Guard",
                "params": {
                  "op": "<",
                  "limit": 0.5
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "clean_fpr_score",
      "weight": 0.25,
      "failure_tag": "flagging_recall_or_overflag",
      "label": "Clean Visibility False-Positive Guard",
      "expr": {
        "combine": "min_of",
        "children": [
          {
            "observable": "precal.clean_false_positive_rate",
            "primitive": "upper_ramp",
            "label": "Clean False-Positive Rate",
            "params": {
              "strict_pass": true,
              "pass_max_key": [
                "tolerances.clean_false_positive_max"
              ],
              "decay_span": 0.15
            }
          },
          {
            "observable": "precal.calibrator_clean_false_positive_rate",
            "primitive": "upper_ramp",
            "label": "Calibrator Clean False-Positive Rate",
            "params": {
              "strict_pass": true,
              "pass_max_key": [
                "tolerances.clean_false_positive_max"
              ],
              "decay_span": 0.15
            }
          }
        ]
      }
    }
  ]
}
