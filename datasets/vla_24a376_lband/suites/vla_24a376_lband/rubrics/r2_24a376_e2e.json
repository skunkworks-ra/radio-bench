{
  "schema_version": "0.2",
  "task_id": "r2_24a376_e2e",
  "stages": [
    "inspect",
    "precal",
    "calibrate",
    "image"
  ],
  "pass_reward_min": 0.85,
  "expect_halt": false,
  "required_reported_metrics": [],
  "hard_gates": [
    {
      "id": "unlocked_tables",
      "observable": "proc.table_locked",
      "primitive": "bool_pass",
      "params": {
        "expected": false
      },
      "zero_reward_on_fail": true,
      "zero_subscores_on_fail": true,
      "failure_tag": "lock_or_timeout"
    },
    {
      "id": "raw_data_unmodified",
      "observable": "proc.raw_data_unmodified",
      "primitive": "bool_pass",
      "params": {
        "expected": true
      },
      "zero_reward_on_fail": true,
      "optional_when_truth_missing": true,
      "failure_tag": "raw_data_or_calflag_mutation"
    }
  ],
  "core_subscore_floors": {},
  "stage_blocks": [
    {
      "id": "calibration_score",
      "stage": "calibrate",
      "weight": 0.6,
      "subscore_prefix": "cal_",
      "truth_prefix": "calibrate_ground_truth",
      "failure_tag": "skipped_delay_or_bandpass",
      "subscores": [
        {
          "id": "retention_score",
          "weight": 0.2,
          "failure_tag": "flagging_recall_or_overflag",
          "label": "Target Retention & Calibration Sanity",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "observable": "cal.target_row_retention",
                "primitive": "window_ramp",
                "label": "Target Unflagged Retention",
                "params": {
                  "min_key": "tolerances.target_unflagged_rows_min",
                  "max_key": "tolerances.target_unflagged_rows_max",
                  "pad_low": 0.3,
                  "pad_high": 0.08,
                  "strict_positive": true
                }
              },
              {
                "observable": "cal.corrected_distinct_from_data",
                "primitive": "bool_pass",
                "label": "CORRECTED_DATA Populated & Distinct",
                "params": {
                  "expected": true
                }
              },
              {
                "observable": "cal.target_corrected_std_jy",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">",
                  "limit": 1e-05
                }
              },
              {
                "observable": "cal.rank1_logamp_rms_median",
                "primitive": "threshold_gate",
                "label": "Rank-1 Gain Closure Log-Amp RMS",
                "params": {
                  "op": "<=",
                  "limit": 0.15
                }
              }
            ]
          }
        },
        {
          "id": "bandpass_flatness_score",
          "weight": 0.25,
          "failure_tag": "skipped_delay_or_bandpass",
          "label": "Bandpass & Delay Channel Phase RMS",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "combine": "min_of",
                "children": [
                  {
                    "observable": "cal.bandpass_coh_chan_phase_rms_deg",
                    "primitive": "upper_ramp",
                    "label": "Bandpass Coherent Channel Phase RMS (deg)",
                    "unit": "deg",
                    "params": {
                      "strict_pass": true,
                      "pass_max_key": "tolerances.bp_channel_phase_rms_max_deg",
                      "decay_span": 12.0
                    }
                  },
                  {
                    "observable": "cal.bandpass_med_bl_chan_phase_rms_deg",
                    "primitive": "upper_ramp",
                    "label": "Bandpass Med-Baseline Channel Phase RMS (deg)",
                    "unit": "deg",
                    "params": {
                      "strict_pass": true,
                      "pass_max_key": "tolerances.bp_channel_phase_rms_max_deg",
                      "decay_span": 12.0
                    }
                  },
                  {
                    "observable": "cal.bandpass_row_chan_phase_rms_deg",
                    "primitive": "upper_ramp",
                    "label": "Bandpass Per-Row Channel Phase RMS (deg)",
                    "unit": "deg",
                    "params": {
                      "strict_pass": true,
                      "pass_max_key": "tolerances.bp_channel_phase_rms_max_deg",
                      "decay_span": 12.0
                    }
                  }
                ]
              },
              {
                "observable": "cal.bandpass_cal_calibrated",
                "primitive": "bool_pass",
                "params": {
                  "expected": true
                }
              },
              {
                "observable": "cal.bandpass_cal_unflagged_fraction",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 0.5
                }
              }
            ]
          }
        },
        {
          "id": "fluxscale_score",
          "weight": 0.25,
          "failure_tag": "flux_model_or_fluxscale_error",
          "label": "Phase Calibrator Fluxscale Accuracy",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "combine": "max_of",
                "children": [
                  {
                    "observable": "cal.phase_cal_corrected_amp_jy",
                    "primitive": "rel_err_ramp",
                    "label": "Phase Cal Corrected Amp (Jy)",
                    "unit": "Jy",
                    "params": {
                      "truth_key": "phase_cal_expected_flux_jy",
                      "pass_rel_tol_key": "tolerances.phase_cal_flux_rel_tol",
                      "decay_span_mult_of_tol": 2.0
                    }
                  },
                  {
                    "observable": "cal.fluxscale_table_flux_jy",
                    "primitive": "rel_err_ramp",
                    "label": "Phase Cal Bootstrapped Table Flux (Jy)",
                    "unit": "Jy",
                    "params": {
                      "truth_key": "phase_cal_expected_flux_jy",
                      "pass_rel_tol_key": "tolerances.phase_cal_flux_rel_tol",
                      "decay_span_mult_of_tol": 2.0
                    }
                  }
                ]
              },
              {
                "observable": "cal.phase_cal_unflagged_fraction",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 0.5
                }
              }
            ]
          }
        },
        {
          "id": "target_fidelity_score",
          "weight": 0.3,
          "failure_tag": "skipped_delay_or_bandpass",
          "symptom_only": true,
          "label": "Target Fixed-Recipe 4k Verifier tclean DR",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "observable": "cal.verifier_tclean_dr",
                "primitive": "lower_ramp",
                "label": "Verifier tclean Dynamic Range",
                "params": {
                  "pass_min_key": "tolerances.verifier_tclean_dr_min",
                  "zero_at_scale_of_pass_min": 0.4,
                  "min_denom": 1.0
                }
              },
              {
                "observable": "cal.verifier_tclean_pb_valid",
                "primitive": "bool_pass",
                "label": "Verifier tclean PB & PBcor Valid",
                "params": {
                  "expected": true
                }
              },
              {
                "observable": "cal.verifier_tclean_rms_over_thermal_floor",
                "primitive": "threshold_gate",
                "label": "Verifier RMS / thermal floor",
                "params": {
                  "op": ">=",
                  "limit": 1.0,
                  "pass_if_not_applicable": true
                }
              },
              {
                "observable": "cal.verifier_tclean_offsource_mad_over_rms",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 0.5
                }
              },
              {
                "observable": "cal.target_corrected_std_jy",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">",
                  "limit": 1e-05
                }
              },
              {
                "observable": "cal.rank1_logamp_rms_median",
                "primitive": "threshold_gate",
                "params": {
                  "op": "<=",
                  "limit": 0.15
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "delivered_image_score",
      "stage": "image",
      "weight": 0.4,
      "subscore_prefix": "img_",
      "truth_prefix": "image_ground_truth",
      "failure_tag": "beam_sampling_or_clean_bowl",
      "subscores": [
        {
          "id": "products_score",
          "weight": 0.15,
          "failure_tag": "beam_sampling_or_clean_bowl",
          "label": "CASA Image Products & Primary Beam Consistency",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "observable": "image.valid_product_count",
                "primitive": "discrete_map",
                "label": "Valid Image Product Count",
                "params": {
                  "mapping": {
                    "5": 1.0,
                    "4": 0.6,
                    "3": 0.4,
                    "2": 0.2,
                    "1": 0.0,
                    "0": 0.0
                  },
                  "default": 0.0
                }
              },
              {
                "observable": "image.shapes_and_wcs_valid",
                "primitive": "bool_pass",
                "label": "Image WCS & Spatial Shapes Valid",
                "params": {
                  "expected": true
                }
              },
              {
                "observable": "image.pb_taper_consistent",
                "primitive": "bool_pass",
                "label": "Primary Beam Taper & PBcor Consistent",
                "params": {
                  "expected": true
                }
              }
            ]
          }
        },
        {
          "id": "beam_sampling_score",
          "weight": 0.2,
          "failure_tag": "beam_sampling_or_clean_bowl",
          "label": "Restoring Beam Pixel Sampling",
          "expr": {
            "observable": "image.pixels_per_beam",
            "primitive": "window_ramp",
            "label": "Pixels Per Beam",
            "params": {
              "min_key": "tolerances.pixels_per_beam_min",
              "max_key": "tolerances.pixels_per_beam_max",
              "low_zero_at": 1.5,
              "pad_high": 5.0
            }
          }
        },
        {
          "id": "residual_rms_score",
          "weight": 0.25,
          "failure_tag": "beam_sampling_or_clean_bowl",
          "label": "Off-Source Residual RMS",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "observable": "image.offsource_residual_rms_jy",
                "primitive": "upper_ramp",
                "label": "Off-Source Residual RMS (Jy/beam)",
                "unit": "Jy/beam",
                "params": {
                  "strict_pass": true,
                  "pass_max_key": "tolerances.off_source_residual_rms_max_jy_per_beam",
                  "decay_span_mult_of_pass_max": 1.7
                }
              },
              {
                "observable": "image.offsource_rms_over_thermal_floor",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 1.0,
                  "pass_if_not_applicable": true
                },
                "label": "Residual RMS / thermal floor"
              },
              {
                "observable": "image.offsource_residual_mad_over_rms",
                "primitive": "threshold_gate",
                "label": "Off-Source Residual MAD/RMS",
                "params": {
                  "op": ">=",
                  "limit": 0.5
                }
              }
            ]
          }
        },
        {
          "id": "deconv_and_bowl_score",
          "weight": 0.4,
          "failure_tag": "beam_sampling_or_clean_bowl",
          "label": "Wideband Mosaic Dynamic Range & Clean Bowl Guard",
          "expr": {
            "combine": "multiplicative_cap",
            "children": [
              {
                "combine": "weighted_sum",
                "weights": [
                  0.7,
                  0.3
                ],
                "children": [
                  {
                    "observable": "image.dynamic_range",
                    "primitive": "lower_ramp",
                    "label": "Mosaic Dynamic Range",
                    "params": {
                      "pass_min_key": "tolerances.dynamic_range_min",
                      "zero_at_scale_of_pass_min": 0.4,
                      "min_denom": 1.0
                    }
                  },
                  {
                    "observable": "image.negative_bowl_ratio",
                    "primitive": "threshold_gate",
                    "label": "Negative Model Bowl Ratio",
                    "params": {
                      "op": "<",
                      "limit_key": "tolerances.negative_model_bowl_ratio_max"
                    }
                  }
                ]
              },
              {
                "observable": "image.negative_bowl_ratio",
                "primitive": "upper_ramp",
                "params": {
                  "strict_pass": true,
                  "pass_max_key": "tolerances.negative_model_bowl_ratio_max",
                  "decay_span_mult_of_pass_max": 1.0,
                  "scale_above_pass": 0.25
                }
              },
              {
                "observable": "image.pb_taper_consistent",
                "primitive": "bool_pass",
                "params": {
                  "expected": true
                }
              },
              {
                "observable": "image.offsource_rms_over_thermal_floor",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 1.0,
                  "pass_if_not_applicable": true
                },
                "label": "Residual RMS / thermal floor"
              },
              {
                "observable": "image.offsource_residual_mad_over_rms",
                "primitive": "threshold_gate",
                "params": {
                  "op": ">=",
                  "limit": 0.5
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
